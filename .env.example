# Copy this file to `.env` in the project root and fill in values.
# Never commit the real `.env` file. Never put API keys in source code.

APP_NAME=AI Finance Management
APP_ENV=development
APP_DEBUG=true

# FastAPI
API_HOST=127.0.0.1
API_PORT=8000

# PostgreSQL (SQLAlchemy + psycopg v3)
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/ai_finance

# Allow the React dev server to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Maximum upload size in bytes (10 MB). Used from Phase 1.
MAX_UPLOAD_BYTES=10485760

# Market data (Phase 6). Get a key from alphavantage.co; never commit the real key.
# Free keys are heavily rate limited (a handful of requests per minute, ~25 per day).
MARKET_DATA_PROVIDER=alpha_vantage
MARKET_DATA_TIMEOUT_SECONDS=10
ALPHA_VANTAGE_API_KEY=
# News headlines for sentiment (Phase 8). Never commit the real key.
NEWS_PROVIDER=newsapi
NEWS_TIMEOUT_SECONDS=10
NEWS_PAGE_SIZE=50
NEWS_API_KEY=
LLM_API_KEY=
